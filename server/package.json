{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../.env watch src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "build": "tsc --noEmit",
    "migrate": "tsx --env-file-if-exists=../.env src/db/migrate.ts",
    "seed": "tsx --env-file-if-exists=../.env src/db/seed.ts",
    "test": "vitest run",
    "jobs": "tsx --env-file-if-exists=../.env src/jobs-cli.ts",
    "demo-history": "tsx --env-file-if-exists=../.env src/db/demo-history.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
