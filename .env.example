# Copy to .env (loaded automatically by the server scripts). Never commit .env. Nothing here belongs in the web client.
DATABASE_URL=postgres://user:password@host:5432/cairn
SESSION_SECRET=change-me-to-a-long-random-string     # 32+ characters (openssl rand -hex 32); JWT_SECRET is accepted as the older name
CRON_SECRET=change-me-too                             # 24+ characters; also a GitHub Actions secret
WEB_ORIGIN=http://localhost:5173
PUBLIC_URL=                                          # e.g. https://cairn.example.com; required in production for OAuth callbacks

# Sign-in. Each provider appears on the sign-in page only when both its values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=                                 # optional; default ${PUBLIC_URL}/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=                                 # optional; default ${PUBLIC_URL}/api/auth/github/callback

# Existing email-and-password account (optional). Created on first boot only when both are set.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_GITHUB=                                        # optional: numeric GitHub user id whose first sign-in attaches to that account

# Public contact address shown on /privacy and /terms (optional).
SUPPORT_EMAIL=

# Google Search Console verification token, e.g. google1a2b3c4d5e6f7890 (needed once, to publish the Google sign-in app).
GOOGLE_SITE_VERIFICATION=

# Web Push (free). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Strategist (optional). Without a key the advisory panel is simply absent.
ANTHROPIC_API_KEY=
STRATEGIST_MODEL=claude-sonnet-5-5

# Source switches (defaults shown).
SOURCE_LEETCODE=on              # LeetCode has no documented API; its site's GraphQL is used, isolated in one adapter
SOURCE_CODECHEF_CONTESTS=on     # CodeChef's own contest listing
SOURCE_CODECHEF_PROFILE=off     # CodeChef's terms prohibit scraping profile pages; figures are entered instead
SCHEDULER=on                    # in-process minute scheduler for reminders and sync

# Optional aggregator, used only where no direct source exists (HackerRank contests).
CLIST_USERNAME=
CLIST_API_KEY=
